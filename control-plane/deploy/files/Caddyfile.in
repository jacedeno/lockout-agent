# Control plane reverse proxy (installed by control-plane/deploy/provision.sh).
# /healthz and the receipt key are answered here; everything else goes to the app (arz-web).

@HOST@ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Ed25519 public key that signs job receipts (hex). Verify a bundle with:
	#   arz-receipt verify receipt.zip --pubkey $(curl -s https://@HOST@/.well-known/receipt-key)
	handle /.well-known/receipt-key {
		header Content-Type "text/plain; charset=utf-8"
		respond "@RECEIPT_PUBKEY@" 200
	}

	handle /api/verify {
		request_body {
			max_size 11MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1  # stream the live timeline (SSE) as it happens
		}
	}
}

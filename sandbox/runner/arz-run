#!/usr/bin/env python3
"""Run one job step inside a locked container and print a JSON summary.

Job directory layout (created by the control plane):
  <job>/input/   read-only to the container
  <job>/code/    read-only to the container; holds the script to run
  <job>/out/     the only writable mount; artifacts land here

The summary records the exact container flags, the image ID, timings, exit code,
OOM/timeout status and the SHA-256 of stdout, stderr and every artifact, so the
control plane can recompute and compare them after pulling the files.

The container controls <job>/out/, so nothing in it is trusted: only regular files are
listed and hashed (lstat, O_NOFOLLOW; links, FIFOs, sockets and devices are skipped and
reported), the artifact count and total size are capped, and only the first
--max-stream-bytes of stdout and stderr are kept. Every cut is recorded in the summary.
"""

import argparse
import datetime
import hashlib
import json
import os
import stat
import subprocess
import sys
import threading
import uuid


def sha256_file(path):
    """SHA-256 of a regular file, never following a symlink or blocking on a FIFO."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise ValueError(f"not a regular file: {path}")
        h = hashlib.sha256()
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def pump(src, path, cap, stats):
    """Copy a stream to path, keeping only the first cap bytes but draining all of it."""
    kept = seen = 0
    with open(path, "wb") as f:
        for chunk in iter(lambda: src.read(65536), b""):
            seen += len(chunk)
            if kept < cap:
                part = chunk[:cap - kept]
                f.write(part)
                kept += len(part)
    stats.update(bytes_seen=seen, bytes_kept=kept, truncated=seen > kept)


def collect_artifacts(out, job, max_count, max_bytes):
    """List and hash regular files under out, within the count and size caps."""
    artifacts, skipped, total = [], [], 0
    for root, dirs, files in os.walk(out, followlinks=False):
        dirs.sort()
        for name in sorted(files + dirs):
            path = os.path.join(root, name)
            rel = os.path.relpath(path, job)
            st = os.lstat(path)
            if stat.S_ISDIR(st.st_mode):
                continue  # os.walk descends into real directories itself
            if not stat.S_ISREG(st.st_mode):
                skipped.append({"path": rel, "reason": "not a regular file"})
                continue
            if len(artifacts) >= max_count or total + st.st_size > max_bytes:
                skipped.append({"path": rel, "bytes": st.st_size, "reason": "over the artifact cap"})
                continue
            try:
                digest = sha256_file(path)
            except (OSError, ValueError) as e:
                skipped.append({"path": rel, "reason": f"unreadable: {e.__class__.__name__}"})
                continue
            total += st.st_size
            artifacts.append({"path": rel, "bytes": st.st_size, "sha256": digest})
    return artifacts, skipped, total


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--job", required=True, help="job directory")
    p.add_argument("--script", required=True, help="file name inside <job>/code/")
    p.add_argument("--timeout", type=int, default=60, help="wall-clock seconds before the container is killed")
    p.add_argument("--memory", default="512m")
    p.add_argument("--pids", type=int, default=128)
    p.add_argument("--cpus", default="1")
    p.add_argument("--engine", default="docker", choices=("docker", "podman"))
    p.add_argument("--runtime", default=None, help="OCI runtime, e.g. runsc for gVisor")
    p.add_argument("--image", default="arz-runner:latest")
    p.add_argument("--max-stream-bytes", type=int, default=1 << 20, help="stdout/stderr bytes kept (each)")
    p.add_argument("--max-artifacts", type=int, default=64)
    p.add_argument("--max-artifact-bytes", type=int, default=50 << 20, help="total artifact bytes listed")
    args = p.parse_args()

    job = os.path.abspath(args.job)
    out = os.path.join(job, "out")
    os.makedirs(out, exist_ok=True)
    try:
        os.chown(out, 65534, 65534)  # the container's user; needs root on the host
    except PermissionError:
        os.chmod(out, 0o777)  # rootless engines map the user elsewhere
    name = f"arz-{uuid.uuid4().hex[:12]}"
    flags = [
        "--network", "none",
        "--read-only",
        "--tmpfs", "/tmp:rw,nosuid,nodev,size=64m",
        "--memory", args.memory, "--memory-swap", args.memory,
        "--pids-limit", str(args.pids),
        "--cpus", args.cpus,
        "--cap-drop", "ALL",
        "--security-opt", "no-new-privileges",
        "--user", "65534:65534",
        "-v", f"{job}/input:/work/input:ro",
        "-v", f"{job}/code:/work/code:ro",
        "-v", f"{out}:/work/out:rw",
    ]
    if args.engine == "docker":
        # The daemon also logs the container's output to disk; bound that copy too.
        flags += ["--log-driver", "json-file", "--log-opt", "max-size=1m", "--log-opt", "max-file=1"]
    if args.runtime:
        flags += ["--runtime", args.runtime]
    cmd = [args.engine, "run", "--name", name, *flags, args.image, f"/work/code/{args.script}"]

    stdout_path, stderr_path = os.path.join(job, f"{name}.stdout"), os.path.join(job, f"{name}.stderr")
    started, timed_out = now(), False
    out_stats, err_stats = {}, {}
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    pumps = [threading.Thread(target=pump, args=(proc.stdout, stdout_path, args.max_stream_bytes, out_stats)),
             threading.Thread(target=pump, args=(proc.stderr, stderr_path, args.max_stream_bytes, err_stats))]
    for t in pumps:
        t.start()
    try:
        proc.wait(timeout=args.timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        subprocess.run([args.engine, "kill", name], capture_output=True)
        proc.wait()
    for t in pumps:
        t.join()
    ended = now()

    state = json.loads(subprocess.run([args.engine, "inspect", name], capture_output=True, text=True).stdout or "[{}]")[0]
    subprocess.run([args.engine, "rm", "-f", name], capture_output=True)
    image_id = subprocess.run([args.engine, "image", "inspect", "--format", "{{.Id}}", args.image],
                              capture_output=True, text=True).stdout.strip()

    artifacts, skipped, total = collect_artifacts(out, job, args.max_artifacts, args.max_artifact_bytes)

    summary = {
        "container": name,
        "engine": args.engine,
        "runtime": args.runtime or "default",
        "image": args.image,
        "image_id": image_id,
        "command": cmd,
        "script": {"name": args.script, "sha256": sha256_file(os.path.join(job, "code", args.script))},
        "limits": {"timeout_s": args.timeout, "memory": args.memory, "pids": args.pids, "cpus": args.cpus,
                   "max_stream_bytes": args.max_stream_bytes, "max_artifacts": args.max_artifacts,
                   "max_artifact_bytes": args.max_artifact_bytes},
        "started_at": started,
        "ended_at": ended,
        "exit_code": state.get("State", {}).get("ExitCode", proc.returncode),
        "oom_killed": bool(state.get("State", {}).get("OOMKilled", False)),
        "timed_out": timed_out,
        "stdout": {"path": os.path.relpath(stdout_path, job), "sha256": sha256_file(stdout_path), **out_stats},
        "stderr": {"path": os.path.relpath(stderr_path, job), "sha256": sha256_file(stderr_path), **err_stats},
        "artifacts": artifacts,
        "artifacts_bytes": total,
        "artifacts_skipped": skipped,
        "artifacts_truncated": any(s["reason"] == "over the artifact cap" for s in skipped),
    }
    print(json.dumps(summary, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())

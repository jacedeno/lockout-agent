#!/usr/sbin/nft -f
# Sandbox VM firewall. Loaded by nftables.service at early boot, before any network is up.
# Default-drop both ways. Allowed: loopback, replies, SSH in from the control plane's VPC,
# DHCP, and (boot phase only) the metadata endpoint cloud-init needs. arz-lockdown.service
# reloads this file without the metadata rule once cloud-init has finished.
flush ruleset

table inet arz {
  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
    ip saddr @VPC_SUBNET@ tcp dport 22 accept
    udp sport 67 udp dport 68 accept
  }

  chain output {
    type filter hook output priority 0; policy drop;
    oif "lo" accept
    ct state established,related accept
    ip daddr @VPC_SUBNET@ accept
    udp sport 68 udp dport 67 accept
    @METADATA_RULE@
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }
}

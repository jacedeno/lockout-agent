[Unit]
Description=Drop the boot-time metadata allowance once cloud-init has finished
After=cloud-final.service
Wants=cloud-final.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/arz/firewall-strict.nft
RemainAfterExit=yes

[Install]
# Not multi-user.target: cloud-final.service is ordered after multi-user.target, so that
# would be an ordering cycle and systemd silently drops this unit (seen 2026-10-23).
WantedBy=cloud-init.target
